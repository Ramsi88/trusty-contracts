{
  "include": ["src", "test", "artifacts", "typechain-types", "./hardhat.config.ts"],
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
