{
  "name": "trusty-contracts",
  "version": "2.0.0",
  "description": "Hardhat framework to run, test and deploy Trusty Factory and Trusty multi-signature environment",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "compile": "npx hardhat compile",
    "start": "npx hardhat run scripts/run.ts",
    "deploy": "npx hardhat run scripts/deploy.ts --build-profile production --network",
    "deploy-advanced": "npx hardhat run scripts/deployAdvanced.ts --build-profile production --network",
    "deploy-recovery": "npx hardhat run scripts/deployRecovery.ts --build-profile production --network",
    "deploy-factory": "npx hardhat run scripts/deployFactory.ts --build-profile production --network",
    "deploy-factory-advanced": "npx hardhat run scripts/deployFactoryAdvanced.ts --build-profile production --network",
    "deploy-ledger": "npx hardhat ignition deploy ignition/modules/Deploy.ts --reset --network",
    "verify": "npx hardhat verify --network",
    "keystore": "npx hardhat keystore set",
    "test": "hardhat test",
    "test-id": "hardhat test --grep",
    "test-gas": "hardhat test --gas-stats",
    "test-all": "hardhat test --grep 'TRUSTY multisig tests'",
    "solhint": "npx hardhat check",
    "coverage": "hardhat test --coverage"
  },
  "keywords": [],
  "author": "Ramzi Bougammoura",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.4",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.2",
    "@nomicfoundation/hardhat-ignition": "^3.0.6",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.6",
    "@nomicfoundation/hardhat-ledger": "^3.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@types/prompt-sync": "^4.2.3",
    "ethers": "^6.13.4",
    "hardhat": "^3.1.3",
    "keccak": "^3.0.4",
    "viem": "^2.44.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "dotenv": "^16.0.3",
    "prompt-sync": "^4.2.0"
  }
}
